.vscode/

# Konfigurasi DevTools Flutter — lokal per-mesin.
devtools_options.yaml

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Laporan Gradle (problems-report, dll.) — hasil build, bukan sumber.
/android/build/

# ── Signing / keystore — task 0.10 ─────────────────────────────
# JANGAN PERNAH di-commit. CI job `signing-guard` akan menolak.
# Keystore dibuat lokal (task 0.10) dan di-backup manual di luar repo.
*.jks
*.keystore
*.p12
*.pepk
*.p8
*.pk8
*.pem
key.properties
**/key.properties
**/upload-keystore.jks
/android/app/upload-keystore.jks
service-account*.json
**/service-account*.json
/ignore/
/docs/

# ── Sampel musik uji (task 0.9) ───────────────────────────────
# Sampel berhak cipta HANYA untuk pengujian debug di perangkat sendiri.
# JANGAN PERNAH di-commit ke repo publik. Folder tetap dilacak via
# .gitkeep supaya deklarasi direktori di pubspec tidak gagal di CI.
# Guard rilis: ignore/tools/check-release-samples.ps1
assets/samples/*
!assets/samples/.gitkeep


.vscode/templates
# Widget Preview related
.widget_preview/
